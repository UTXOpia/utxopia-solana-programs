# Anchor build artifacts
target/
.anchor/
**/*.rs.bk
.surfpool/

# Node modules (if using npm/yarn for tests)
node_modules/

# Env files
.env
.env.*
!.env.example

# Test artifacts
.DS_Store
coverage/
*.log
*.tsbuildinfo

# Devnet/testnet config (contains test keys)
devnet-config.json
devnet-test-notes.json
.devnet-*.json
.localnet-*.json

# Keypairs / state secrets
*state*.json
*keypair*.json
*demo-seed*
*.pem
*.key

# Test validator data
test-ledger/

# Lock files are COMMITTED here, deliberately. This crate builds a deployed on-chain binary, not
# a library: an uncommitted lock means the bytecode a reviewer builds need not be the bytecode
# that was deployed, which defeats `solana-verify` and any reproducible-build claim. It is also
# what lets CI run `--frozen-lockfile` / `--locked`.
