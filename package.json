{
  "name": "utxopia-contracts",
  "version": "0.1.0",
  "description": "UTXOpia Solana smart contracts (Pinocchio)",
  "scripts": {
    "build": "sh scripts/build-sbf.sh --features devnet",
    "build:devnet": "sh scripts/build-sbf.sh --features devnet",
    "build:devnet-regtest": "sh scripts/build-sbf.sh --features devnet-regtest",
    "build:localnet": "sh scripts/build-sbf.sh --features localnet",
    "build:mainnet": "sh scripts/build-sbf.sh --features mainnet",
    "verify:deployed": "sh scripts/verify-deployed.sh",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "cargo test",
    "test:unit": "cargo test && bun test tests/unit",
    "test:integration": "bun test tests/**/*.test.ts",
    "test:svm": "sh scripts/build-sbf.sh --features devnet-regtest && cargo test --manifest-path programs/svm-tests/Cargo.toml",
    "test:localnet": "bun scripts/e2e-localnet.ts",
    "test:regtest": "bun scripts/regtest-flow.ts",
    "relay:deposit": "bun scripts/relay-deposit.ts",
    "per:devnet": "bun scripts/policy-approval-devnet.ts",
    "regtest:up": "docker compose -f ../docker-compose.regtest.yml up -d",
    "regtest:down": "docker compose -f ../docker-compose.regtest.yml down"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-sdk": "0.16.2",
    "@noble/hashes": "^2.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@utxopia/sdk": "0.1.0-alpha.6",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
